{
  "bar": {
    "layout": {
      "center": [
        {
          "id": "omarchy.clock",
          "format": "ddd d MMM HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/sysmon",
          "id": "sysmon",
          "interval": 3,
          "onClick": "omarchy-launch-or-focus-tui btop",
          "type": "command"
        },
        {
          "exec": "~/.config/omarchy/bar/scripts/music-icon",
          "id": "music",
          "interval": 3600,
          "onClick": "omarchy-launch-or-focus-tui cliamp",
          "type": "command"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.elsewhen",
          "zones": "Rome|Europe/Rome, Delhi|Asia/Kolkata, Tokyo|Asia/Tokyo, Los Angeles|America/Los_Angeles, New York|America/New_York"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [],
  "version": 1
}
