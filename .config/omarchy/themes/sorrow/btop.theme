# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="#101315"

# Main text color
theme[main_fg]="#cacccc"

# Title color for boxes
theme[title]="#cacccc"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#b8384f"

# Background color of selected item in processes box
theme[selected_bg]="#8c2a40"

# Foreground color of selected item in processes box
theme[selected_fg]="#e6e0e1"

# Color of inactive/disabled text
theme[inactive_fg]="#565d60"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="#cbc2be"

# Background color of the percentage meters
theme[meter_bg]="#3d1621"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#a3a6a7"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="#5c1a2b"
theme[mem_box]="#343d41"
theme[net_box]="#5c1a2b"
theme[proc_box]="#343d41"

# Box divider line and small boxes line color
theme[div_line]="#343d41"

# Temperature graph color (Normal -> Warm -> Hot)
theme[temp_start]="#d9dbdc"
theme[temp_mid]="#a8566a"
theme[temp_end]="#b8384f"

# CPU graph colors
theme[cpu_start]="#d9dbdc"
theme[cpu_mid]="#a8566a"
theme[cpu_end]="#b8384f"

# Mem/Disk free meter
theme[free_start]="#d9dbdc"
theme[free_mid]="#a8566a"
theme[free_end]="#b8384f"

# Mem/Disk cached meter
theme[cached_start]="#d9dbdc"
theme[cached_mid]="#a5aeb4"
theme[cached_end]="#8c2a40"

# Mem/Disk available meter
theme[available_start]="#d9dbdc"
theme[available_mid]="#a5aeb4"
theme[available_end]="#8c2a40"

# Mem/Disk used meter
theme[used_start]="#d9dbdc"
theme[used_mid]="#a8566a"
theme[used_end]="#b8384f"

# Download graph colors
theme[download_start]="#d9dbdc"
theme[download_mid]="#a8566a"
theme[download_end]="#b8384f"

# Upload graph colors
theme[upload_start]="#d9dbdc"
theme[upload_mid]="#a8566a"
theme[upload_end]="#b8384f"

# Process box color gradient for threads, mem and cpu usage
theme[process_start]="#d9dbdc"
theme[process_mid]="#a8566a"
theme[process_end]="#b8384f"

# Graph gradient colors
theme[gradient_color_0]="#101315"
theme[gradient_color_1]="#3d1621"
theme[gradient_color_2]="#4b4e55"
theme[gradient_color_3]="#6e2233"
theme[gradient_color_4]="#9fa5a9"
theme[gradient_color_5]="#a8566a"
theme[gradient_color_6]="#d9dbdc"
theme[gradient_color_7]="#b8384f"
